# Copy to .env, then run scripts/init.sh. Do not commit .env.
COMPOSE_PROJECT_NAME=matrix_private
# This is the permanent Matrix identity. Do not change it after initialization.
MATRIX_SERVER_NAME=personal.com
# HTTPS URL for Matrix clients and Element. It must use MATRIX_SERVER_NAME.
PUBLIC_BASE_URL=https://personal.com

POSTGRES_DB=matrix
POSTGRES_USER=root
POSTGRES_PASSWORD=password

# Native Synapse and matching Nginx upload limits (units: K, M, or G).
MAX_UPLOAD_SIZE=20M
MEDIA_UPLOAD_LIMIT_24H=100M
MEDIA_UPLOAD_LIMIT_7D=500M

# Local-only development endpoints. ADMIN_PATH is / or one path segment chain,
# such as /panel, /admin, or /management.
LOCAL_HOST=localhost
LOCAL_ELEMENT_PORT=8080
LOCAL_ADMIN_PORT=8081
ADMIN_PATH=/panel

# Optional self-hosted TURN for legacy one-to-one calls. Keep disabled until
# TURN_HOST resolves to this server and firewall/NAT rules are in place.
TURN_ENABLED=0
TURN_HOST=
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_EXTERNAL_IP=
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_SHARED_SECRET=
