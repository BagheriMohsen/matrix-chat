# Copy to .env, set the required values, then run scripts/init.sh. Do not commit .env.
# Required public domains. MATRIX_SERVER_NAME becomes part of Matrix IDs and is
# immutable after Synapse initialization. PUSH_DOMAIN needs its own TLS certificate.
COMPOSE_PROJECT_NAME=matrix_private
MATRIX_SERVER_NAME=matrix.example.com
PUBLIC_BASE_URL=https://matrix.example.com
PUSH_DOMAIN=push.example.com

# Public routes. Analytics is enabled; PANEL_PATH is reserved and returns 404
# because no Laravel/custom panel is bundled. Ketesa is fixed at /admin/ by its image.
ANALYTICS_PATH=/analytics
PANEL_PATH=/panel
# Optional Analytics login-session lifetime in seconds.
ANALYTICS_SESSION_TTL=3600

# PostgreSQL (required). Replace this placeholder before initializing a fresh server.
POSTGRES_DB=matrix
POSTGRES_USER=root
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Synapse and matching Nginx upload limits (units: K, M, or G).
MAX_UPLOAD_SIZE=20M
MEDIA_UPLOAD_LIMIT_24H=100M
MEDIA_UPLOAD_LIMIT_7D=500M

# Local-only development endpoints. Ketesa remains on /admin/.
LOCAL_HOST=localhost
LOCAL_ELEMENT_PORT=8080
LOCAL_ADMIN_PORT=8081

# Optional self-hosted TURN for legacy one-to-one calls. Keep disabled until
# TURN_HOST resolves to the Matrix domain and firewall/NAT rules are in place.
TURN_ENABLED=0
TURN_HOST=
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_EXTERNAL_IP=
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
TURN_SHARED_SECRET=

# Opt-in MatrixRTC / Element Call backend. Leave disabled until DNS, TLS and
# firewall requirements in docs/matrixrtc.md are met and production approval is
# given. CALL_DOMAIN must be a new public hostname with its own certificate.
MATRIX_RTC_ENABLED=0
CALL_DOMAIN=
CALL_PUBLIC_IP=
CALL_RTC_UDP_PORT=7881
CALL_RTC_TCP_PORT=7881
CALL_RTC_UDP_MIN_PORT=50000
CALL_RTC_UDP_MAX_PORT=50100
