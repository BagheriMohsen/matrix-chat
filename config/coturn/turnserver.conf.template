# Generated from .env; contains the shared TURN secret and is not committed.
listening-ip=0.0.0.0
listening-port=__TURN_PORT__
tls-listening-port=__TURN_TLS_PORT__
external-ip=__TURN_EXTERNAL_IP__
realm=__TURN_HOST__
min-port=__TURN_MIN_PORT__
max-port=__TURN_MAX_PORT__

fingerprint
lt-cred-mech
use-auth-secret
static-auth-secret=__TURN_SHARED_SECRET__
stale-nonce
no-cli
no-tcp-relay
no-multicast-peers
no-loopback-peers
no-tlsv1
no-tlsv1_1

# TURN must not relay to private, loopback, link-local, multicast, or documentation ranges.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=224.0.0.0-255.255.255.255

cert=/etc/coturn/tls/fullchain.pem
pkey=/etc/coturn/tls/privkey.pem
log-file=stdout
