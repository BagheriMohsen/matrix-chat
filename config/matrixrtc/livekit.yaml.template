# Generated by scripts/matrixrtc-prepare.sh. Never commit the rendered file:
# it contains the LiveKit API secret.
port: 7880
bind_addresses:
  - 0.0.0.0
keys:
  __LIVEKIT_API_KEY__: __LIVEKIT_API_SECRET__
rtc:
  # The host must own this public IPv4 address. Do not use Docker/private IPs.
  node_ip: __CALL_PUBLIC_IP__
  tcp_port: __CALL_RTC_TCP_PORT__
  port_range_start: __CALL_RTC_UDP_MIN_PORT__
  port_range_end: __CALL_RTC_UDP_MAX_PORT__
room:
  # Only lk-jwt-service may create rooms after Matrix membership checks.
  auto_create: false
webhook:
  api_key: __LIVEKIT_API_KEY__
  urls:
    - https://__CALL_DOMAIN__/livekit/jwt/sfu_webhook
logging:
  level: info
