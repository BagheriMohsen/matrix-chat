server_name: "ct.koten.ir"
pid_file: /data/homeserver.pid
public_baseurl: "https://ct.koten.ir/"
report_stats: false

listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: true
    resources:
      - names: [client]
        compress: false

database:
  name: psycopg2
  args:
    user: "__POSTGRES_USER__"
    password: "__POSTGRES_PASSWORD__"
    database: "__POSTGRES_DB__"
    host: postgres
    port: 5432
    cp_min: 1
    cp_max: 5

enable_registration: false
enable_registration_without_verification: false
allow_guest_access: false
registration_shared_secret_path: /data/registration_shared_secret

# Empty is Synapse's documented federation-off setting.
federation_domain_whitelist: []
federation_whitelist_endpoint_enabled: false

enable_media_repo: true
media_store_path: /data/media_store
max_upload_size: 20M
url_preview_enabled: false
default_identity_server: null
allow_public_rooms_without_auth: false
allow_public_rooms_over_federation: false
enable_room_list_search: false
alias_creation_rules: []
block_non_admin_invites: true
user_directory:
  enabled: false

rc_message:
  per_second: 0.5
  burst_count: 10
rc_login:
  address: {per_second: 0.2, burst_count: 3}
  account: {per_second: 0.2, burst_count: 3}
  failed_attempts: {per_second: 0.2, burst_count: 3}

signing_key_path: "/data/ct.koten.ir.signing.key"
trusted_key_servers: []
log_config: "/data/ct.koten.ir.log.config"
